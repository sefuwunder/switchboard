# Optional: skip the ClickUp skill helper and call the API directly.
# CLICKUP_TOKEN=pk_your_personal_token
# ClickUp list watched by the ClickUp channel.
# CLICKUP_LIST_ID=901418249044
# Anytype desktop app's local API (default http://127.0.0.1:31009).
# ANYTYPE_BASE_URL=http://127.0.0.1:31009
# Optional: skip in-app pairing and use a fixed Anytype API key
# (Anytype → Settings → API Keys). Otherwise pair from the patch bay card.
# ANYTYPE_API_KEY=your_api_key
# Google OAuth client for the Gmail + Google Calendar channels
# (Google Cloud Console → APIs & Services → Credentials → OAuth client ID,
# type "Web application"). See README "Google OAuth setup".
# GOOGLE_CLIENT_ID=<redacted>
# GOOGLE_CLIENT_SECRET=<redacted>
# Optional: override the OAuth redirect URI (must match what's registered
# in the Cloud console). Default: http://127.0.0.1:3002/api/oauth/google/callback
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3002/api/oauth/google/callback
# GitHub personal access token for the GitHub channel (notifications).
# Create a fine-grained token at https://github.com/settings/personal-access-tokens/new
# with "Notifications: read-only" (see README "GitHub setup").
# GITHUB_TOKEN=<redacted>
# Port for the switchboard UI.
# PORT=3002
